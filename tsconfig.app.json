{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    // OFF, deliberately. Vendored shadcn components (e.g. DropdownMenuCheckboxItem
    // spreading `checked?: CheckedState` into a required prop) do not compile under
    // it, and FRONTEND_STANDARDS §4 forbids editing `components/ui/*`. Flagged for
    // owner review in the W2 report — see mnemos/HANDOFF-W2.md.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vitest/globals"],

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@bindings": ["bindings/tauri.ts"]
    }
  },
  "include": ["src", "bindings"]
}
